# PostgreSQL é o padrão. Nunca versionar o .env com credenciais reais.
APP_ENV=production
ROOMFLOW_PERSISTENCE=postgres
# Preferencial no Supabase; URL codificada, com TLS conforme a conexão fornecida.
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/postgres?sslmode=require
# Alternativa local (ignorada quando DATABASE_URL está preenchida):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=roomflow
DB_USERNAME=postgres
DB_PASSWORD=troque_esta_senha

# Cadastro com confirmação de e-mail e recuperação de senha:
ROOMFLOW_SMTP_HOST=
ROOMFLOW_SMTP_PORT=465
ROOMFLOW_SMTP_FROM=
ROOMFLOW_SMTP_USERNAME=
ROOMFLOW_SMTP_PASSWORD=

# Demo somente com as duas opções explícitas:
# APP_ENV=development
# ROOMFLOW_PERSISTENCE=memory
