# Copie a URI do banco PostgreSQL compartilhado já existente no grupo para
# DATABASE_URL no arquivo .env privado. Não versionar credenciais reais.
APP_ENV=production
ROOMFLOW_PERSISTENCE=postgres
# Supabase: use a string exata fornecida pelo responsável do projeto.
# DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/postgres?sslmode=require
# PostgreSQL local é apenas para desenvolvimento/teste isolado; configure DB_*
# somente no ambiente separado destinado a esse uso.
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_NAME=roomflow_test_example
# DB_USERNAME=postgres
# DB_PASSWORD=
# DB_SSLMODE=require
# DB_CONNECT_TIMEOUT=5
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# ROOMFLOW_TEST_DATABASE=roomflow_test_example

# Cadastro com confirmação de e-mail e recuperação de senha:
ROOMFLOW_SMTP_HOST=
ROOMFLOW_SMTP_PORT=465
ROOMFLOW_SMTP_FROM=
ROOMFLOW_SMTP_USERNAME=
ROOMFLOW_SMTP_PASSWORD=

# Demo somente com as duas opções explícitas:
# APP_ENV=development
# ROOMFLOW_PERSISTENCE=memory
