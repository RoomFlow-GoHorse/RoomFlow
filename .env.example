# PostgreSQL remoto (Supabase, Neon ou servidor gerenciado)
# Prefira DATABASE_URL fornecida pelo provedor; use sslmode=require quando exigido.
# DB_SSLMODE=require
# DB_CONNECT_TIMEOUT=5
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=10
# ROOMFLOW_PERSISTENCE=postgres
# ROOMFLOW_API_URL=https://api.exemplo.org
